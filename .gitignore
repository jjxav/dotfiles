.git*
!.gitignore
!.gitkeep
gits/

.tmux/plugins

.config/*/
!.config/nvim
!.config/cava
!.config/ohmyposh
!.config/hypr
.config/hypr/theme/backgrounds
!.config/pipewire
!.config/wireplumber
!.config/waybar
!.config/wofi

.config/nvim/spell/*
!.config/nvim/spell/en.utf-8.add
!.config/nvim/spell/en.utf-8.add.spl
!.config/nvim/spell/fr.utf-8.add
!.config/nvim/spell/fr.utf-8.add.spl

.local/*
!.local/bin
